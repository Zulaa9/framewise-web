---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { defaultLang, languages, type Lang } from '../i18n/ui';
import { getLangFromUrl, getRouteFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  /** Overrides the default site-wide <title>/og:title (t('meta.title')) — for pages with their own identity (e.g. the privacy policy) rather than the product pitch. */
  title?: string;
  /** Overrides the default site-wide description/og:description (t('meta.description')). */
  description?: string;
}

const { title, description } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const route = getRouteFromUrl(Astro.url);
const t = useTranslations(lang);

const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.svg', Astro.site);

// One <link rel="alternate"> per locale, plus x-default pointing at English.
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: new URL(getRelativeLocaleUrl(code, route), Astro.site).href,
}));

// Same rule as the extension (see detectBrowserLang in Framewise-extension/i18n.js): English only
// if the browser's own UI language starts with "en", Spanish for everything else — English stays
// the fallback of last resort. Only wired on the unprefixed default-locale pages ("/", "/privacy",
// etc.) and only ever redirects towards Spanish, never away from it: a Spanish URL someone opened
// on purpose (a shared link, a bookmark, a search result) must never get redirected out from under
// them just because their browser happens to be in English — same reasoning as not stealing focus
// from a URL the visitor explicitly navigated to. A stored explicit choice (the header's EN/ES
// toggle, see LanguageToggle.astro) always wins over the live browser-language check, and persists
// across visits — matching "once picked, it stays picked" on the extension side too.
const showLangRedirect = lang === defaultLang;
const esHref = showLangRedirect ? getRelativeLocaleUrl('es', route) : '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Google Search Console site-ownership verification for the Chrome Web Store
         listing's "Official URL" field — do not remove, verification depends on it.
         Two tags: the first Search Console property was created under the wrong
         Google account (not the one the Chrome Web Store listing uses), so a second
         one was verified under the right account instead of replacing it — each
         account gets its own token, and a page can carry more than one of these. -->
    <meta name="google-site-verification" content="U6blOlZg4I-lf2Kl5YkfTS9gY7-vsUmFaR3s-wqLMGc" />
    <meta name="google-site-verification" content="VTabtvP3i9HmueDAojhg-DHRM4UkIDQNcIpk3BV3GIw" />
    {showLangRedirect && (
      <script is:inline define:vars={{ esHref }}>
        (function () {
          try {
            var STORAGE_KEY = 'framewise-lang';
            var stored = localStorage.getItem(STORAGE_KEY);
            var wanted = stored;
            if (!wanted) {
              var nav = (navigator.language || (navigator.languages && navigator.languages[0]) || 'en').toLowerCase();
              wanted = nav.indexOf('en') === 0 ? 'en' : 'es';
            }
            if (wanted === 'es') location.replace(esHref);
          } catch (e) {}
        })();
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />

    {alternates.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={alternates.find((a) => a.code === 'en')!.href}
    />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <meta name="theme-color" content="#17181b" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Framewise" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={t('meta.ogAlt')} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-btn focus:bg-ink focus:px-4 focus:py-2 focus:text-ui focus:font-medium focus:text-bg"
    >
      {t('nav.skipToContent')}
    </a>

    <slot />

    <!--
      Re-enables smooth scrolling (see the .fw-smooth rule in global.css) once the
      page has settled past its own initial scroll-to-#hash, which is instant/auto
      by default so that jump actually lands. Double rAF: one frame for the
      browser's own fragment-scroll to happen, a second so anything it triggers
      (layout from a just-swapped-in font, etc.) has also settled before smooth
      scrolling turns back on for whatever the visitor does next.
    -->
    <script is:inline>
      (function () {
        function enableSmoothScroll() {
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('fw-smooth');
          }
        }
        requestAnimationFrame(function () {
          requestAnimationFrame(enableSmoothScroll);
        });
      })();
    </script>
  </body>
</html>
