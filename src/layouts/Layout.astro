---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { languages, type Lang } from '../i18n/ui';
import { getLangFromUrl, getRouteFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const route = getRouteFromUrl(Astro.url);
const t = useTranslations(lang);

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.svg', Astro.site);

// One <link rel="alternate"> per locale, plus x-default pointing at English.
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: new URL(getRelativeLocaleUrl(code, route), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="canonical" href={canonical.href} />

    {alternates.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={alternates.find((a) => a.code === 'en')!.href}
    />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <meta name="theme-color" content="#17181b" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Framewise" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={t('meta.ogAlt')} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-btn focus:bg-ink focus:px-4 focus:py-2 focus:text-ui focus:font-medium focus:text-bg"
    >
      {t('nav.skipToContent')}
    </a>

    <slot />
  </body>
</html>
