---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageToggle from './LanguageToggle.astro';
import ScrollProgress from './ScrollProgress.astro';
import { links } from '../i18n/ui';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = getRelativeLocaleUrl(lang, '');
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 h-19 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-400 ease-out"
>
  <!--
    This row overlaps the section rail below: the rail's 24px hit band starts at
    y=51 and the CTA button extends to y=59. `relative z-10` puts the row on top
    so those 8px stay clickable as the button.

    But the row is h-full, so on its own it would then block the rail across the
    entire header width. Hence pointer-events-none on the box and auto on the
    anchors inside — only the actual controls capture the pointer, and the rail
    receives everything else.
  -->
  <div
    class="relative z-10 mx-auto flex h-full items-center justify-between gap-4 px-5 pointer-events-none sm:px-6 md:px-13 [&_a]:pointer-events-auto"
  >
    <a
      href={home}
      aria-label={t('nav.home')}
      class="flex items-center gap-2.5 rounded-btn"
    >
      <img src="/logo.png" alt="" width="24" height="24" class="rounded-btn" />
      <span class="text-ui font-medium tracking-wordmark">Framewise</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <LanguageToggle />

      <!--
        Hidden on the narrowest screens: logo + language toggle + this button
        need 397px, which overflows a 375px viewport (and "Añadir a Chrome" is
        wider still). The hero's primary CTA sits directly below, so nothing is
        actually lost.
      -->
      <a
        href={links.chrome}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-btn border border-line-strong px-4 py-2.5 text-ui-sm font-medium whitespace-nowrap transition-colors duration-200 hover:border-line-hover sm:block"
      >
        {t('nav.cta')}
      </a>
    </div>
  </div>

  <ScrollProgress />
</header>

<style>
  /* Transparent over the hero, then frosted once the page starts scrolling.
     Toggled by the script below so there is no layout-shifting scroll listener
     doing style writes on every frame. */
  #site-header.is-scrolled {
    background-color: var(--color-nav);
    border-bottom-color: var(--color-line-soft);
    backdrop-filter: blur(14px);
  }
</style>

<script>
  const header = document.getElementById('site-header');

  if (header) {
    // No requestAnimationFrame latch: rAF is suspended while the tab is hidden,
    // so a "ticking" flag set during a background scroll would never clear and
    // the header would stay stuck in whichever state it was in. Toggling a class
    // to the value it already has is a no-op, so running this per scroll event
    // is cheaper than guarding it.
    const sync = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 40);
    };

    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
