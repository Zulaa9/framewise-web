---
import FeatureHeading from './FeatureHeading.astro';
import DemoVideo from '../DemoVideo.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!--
  04 — video left, result panel right.

  Both capture mechanisms are real, unchanged from before — a canvas draw of
  the actual current frame for the PNG, a real MediaRecorder for the .webm.
  What changed is the *experience*: clicking no longer downloads anything
  immediately. The real blob is held in memory, its thumbnail flies from the
  video to the panel on the right (a genuine frame of the actual capture, not
  a placeholder), and the visitor downloads on their own terms via the panel's
  own button. Same real files, just handed over when asked for rather than
  the instant a button is pressed.
-->
<section aria-labelledby="f4-title" class="mx-auto max-w-page px-6">
  <FeatureHeading
    number="04"
    id="f4-title"
    label="f4.label"
    title="f4.title"
    body="f4.body"
    class="mx-auto max-w-[35rem]"
    bodyClass="max-w-[25rem]"
  />

  <!-- Everything below — video, panel and the record button — is one demo
       unit; the script queries all of it relative to this wrapper. -->
  <div data-capture-demo class="mt-12">
    <div class="relative grid gap-5 lg:grid-cols-[3fr_2fr] lg:items-stretch">
      <figure
        data-capture-video-figure
        class="relative overflow-hidden rounded-shot border border-line-compare shadow-frame"
      >
        <DemoVideo
          src="/media/city-traffic.mp4"
          type="video/mp4"
          label={t('f4.video.label')}
          heightClass="h-[18.75rem] min-h-56 lg:h-full"
        >
          <!-- Shutter flash: local feedback that a frame was grabbed,
               separate from the fly-to-panel animation below. A plain white
               layer, opacity animated from JS rather than via a CSS class
               toggle, so rapid repeat captures each restart the flash
               instead of the second click landing mid-transition and doing
               nothing visible. -->
          <div
            data-capture-flash
            class="pointer-events-none absolute inset-0 bg-ink opacity-0"
            aria-hidden="true"
          >
          </div>

          <!-- Screenshot trigger — right edge, vertically centred, as
               specced. -->
          <button
            type="button"
            data-capture-button
            aria-label={t('f4.capture.button')}
            class="absolute top-1/2 right-4 flex size-11 -translate-y-1/2 items-center justify-center rounded-full border border-line-strong bg-chip-soft text-ink backdrop-blur-[10px] transition-colors duration-150 hover:bg-chip md:right-6"
          >
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M4 6.5h2.2l.9-1.6c.2-.3.5-.5.9-.5h4c.4 0 .7.2.9.5l.9 1.6H16a1 1 0 0 1 1 1V15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7.5a1 1 0 0 1 1-1Z"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linejoin="round"
              ></path>
              <circle cx="10" cy="10.5" r="2.6" stroke="currentColor" stroke-width="1.3"></circle>
            </svg>
          </button>

          <!-- Recording indicator, appears only while actively recording. -->
          <div
            data-record-indicator
            hidden
            class="absolute top-4 right-4 flex items-center gap-2 rounded-btn border border-line bg-chip-soft px-3 py-2 font-mono text-label tracking-chip text-ink backdrop-blur-[10px] md:top-6 md:right-6"
          >
            <span
              class="size-1.5 shrink-0 animate-[fw-pulse_1.1s_ease-in-out_infinite] rounded-full bg-accent"
              aria-hidden="true"
            ></span>
            <span>{t('f4.record.indicator')}</span>
            <span data-record-timer class="tabular-nums">0:00</span>
          </div>
        </DemoVideo>
      </figure>

      <!--
        Result panel. Holds exactly one result at a time — the most recent
        capture or recording — not a gallery. Same footprint whether empty
        or full so nothing reflows around it as results land.
      -->
      <div
        data-result-panel
        role="group"
        aria-label={t('f4.panel.label')}
        class="relative flex flex-col overflow-hidden rounded-shot border border-line-compare bg-fill-ghost shadow-frame-sm"
      >
        <div data-panel-media class="group relative min-h-56 flex-1">
          <div
            data-panel-empty
            class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center transition-opacity duration-200"
          >
            <svg
              width="28"
              height="28"
              viewBox="0 0 20 20"
              fill="none"
              class="text-ink-subtle"
              aria-hidden="true"
            >
              <rect x="2.5" y="4" width="15" height="12" rx="1.5" stroke="currentColor" stroke-width="1.3"></rect>
              <circle cx="7" cy="8.5" r="1.3" stroke="currentColor" stroke-width="1.3"></circle>
              <path
                d="M4 14 8.5 10 11.5 12.5 14 10.5 16 12.5"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <p class="text-sm text-ink-faint">{t('f4.panel.empty')}</p>
          </div>

          <!-- Screenshot result: the captured PNG itself. No transition: it
               appears the instant the fly-in clone above lands in the exact
               same spot at the exact same size, so an instant swap reads as
               the capture simply arriving rather than a crossfade papering
               over a mismatch. -->
          <img
            data-panel-thumb
            alt=""
            class="absolute inset-0 h-full w-full object-cover opacity-0"
          />

          <!-- Clip result: the actual recorded .webm, genuinely playable
               here — not just a poster standing in for "a video exists".
               `poster` is the real freeze frame grabbed the instant
               recording stopped, so there's a real frame on screen before
               the visitor presses play rather than a black rectangle. No
               native `controls` — a single custom play/pause button instead,
               to match the rest of this page's own button language rather
               than dropping the browser's stock control bar onto an
               otherwise fully custom-styled panel. -->
          <video
            data-panel-video
            hidden
            playsinline
            class="absolute inset-0 h-full w-full cursor-pointer object-cover opacity-0"
          ></video>

          <!-- Centre play/pause toggle, YouTube-style: always visible while
               paused (so it's obvious the clip is playable at all), fades
               out quickly once playing and the cursor leaves rather than
               sitting over the footage the whole time. The clickable target
               for toggling is the whole media area (see script) — this
               button is also independently clickable/focusable so keyboard
               and screen-reader users have an actual control, not just a
               click-anywhere area. -->
          <button
            type="button"
            data-panel-play-toggle
            hidden
            data-label-play={t('f1.play')}
            data-label-pause={t('f1.pause')}
            aria-label={t('f1.play')}
            class="absolute top-1/2 left-1/2 flex size-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-line-strong bg-chip-soft text-ink opacity-0 backdrop-blur-[10px] transition-opacity duration-100 group-hover:opacity-100 group-focus-within:opacity-100"
          >
            <svg
              data-panel-play-icon
              width="20"
              height="20"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path d="M6 4.5v11l9-5.5-9-5.5Z" fill="currentColor"></path>
            </svg>
          </button>

          <!-- Clip duration badge — shown only when the current result is a
               recording, positioned like every other media chip on this
               page. -->
          <span
            data-panel-duration
            hidden
            class="absolute bottom-3 left-3 rounded-btn border border-line bg-chip-soft px-2.5 py-1 font-mono text-label tracking-chip text-ink backdrop-blur-[10px]"
          ></span>
        </div>

        <!-- Footer stays out of the layout until there is something to act
             on — a Download button with nothing behind it yet is worse than
             no button at all. -->
        <div
          data-panel-footer
          hidden
          class="flex items-center justify-between gap-3 border-t border-line-soft px-4 py-3"
        >
          <span
            data-panel-kind
            data-frame-label={t('f4.panel.frame')}
            data-clip-label={t('f4.panel.clip')}
            role="status"
            aria-live="polite"
            class="text-xs text-ink-faint"
          ></span>
          <button
            type="button"
            data-panel-download
            class="rounded-btn border border-line-strong px-3.5 py-2 text-xs font-medium transition-colors duration-150 hover:border-line-hover"
          >
            {t('f4.panel.download')}
          </button>
        </div>
      </div>
    </div>

    <div class="mt-6 flex justify-center">
      <button
        type="button"
        data-record-toggle
        data-label-start={t('f4.record.start')}
        data-label-stop={t('f4.record.stop')}
        aria-pressed="false"
        class="flex items-center gap-2 rounded-cta border border-line-strong px-6 py-3 text-ui font-medium transition-colors duration-150 hover:border-line-hover"
      >
        <svg
          data-record-icon
          width="14"
          height="14"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="10" cy="10" r="7" fill="var(--color-accent)"></circle>
        </svg>
        <span data-record-label>{t('f4.record.start')}</span>
      </button>
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-capture-demo]')
    .forEach((root) => {
      const video = root.querySelector<HTMLVideoElement>('[data-demo-video]');
      const videoFigure = root.querySelector<HTMLElement>(
        '[data-capture-video-figure]',
      );
      const captureButton =
        root.querySelector<HTMLButtonElement>('[data-capture-button]');
      const flash = root.querySelector<HTMLElement>('[data-capture-flash]');
      const recordButton =
        root.querySelector<HTMLButtonElement>('[data-record-toggle]');
      const recordLabel = root.querySelector<HTMLElement>('[data-record-label]');
      const recordIcon = root.querySelector<SVGElement>('[data-record-icon]');
      const recordIndicator =
        root.querySelector<HTMLElement>('[data-record-indicator]');
      const recordTimer = root.querySelector<HTMLElement>('[data-record-timer]');
      const panelEmpty = root.querySelector<HTMLElement>('[data-panel-empty]');
      const panelThumb = root.querySelector<HTMLImageElement>('[data-panel-thumb]');
      const panelMedia = root.querySelector<HTMLElement>('[data-panel-media]');
      const panelVideo = root.querySelector<HTMLVideoElement>('[data-panel-video]');
      const panelPlayToggle =
        root.querySelector<HTMLButtonElement>('[data-panel-play-toggle]');
      const panelPlayIcon =
        root.querySelector<SVGElement>('[data-panel-play-icon]');
      const panelDuration =
        root.querySelector<HTMLElement>('[data-panel-duration]');
      const panelFooter = root.querySelector<HTMLElement>('[data-panel-footer]');
      const panelKind = root.querySelector<HTMLElement>('[data-panel-kind]');
      const panelDownload =
        root.querySelector<HTMLButtonElement>('[data-panel-download]');
      if (
        !video || !videoFigure || !captureButton || !flash || !recordButton ||
        !recordLabel || !recordIcon || !recordIndicator || !recordTimer ||
        !panelMedia || !panelEmpty || !panelThumb || !panelVideo ||
        !panelPlayToggle || !panelPlayIcon || !panelDuration || !panelFooter ||
        !panelKind || !panelDownload
      ) {
        return;
      }

      const frameLabel = panelKind.dataset.frameLabel ?? '';
      const clipLabel = panelKind.dataset.clipLabel ?? '';

      // --- Custom play/pause for the clip preview -----------------------------
      // No native `controls`: a single centre toggle instead, matching the
      // rest of the page's own button language. `▶` / `❚❚` paths reused
      // verbatim from FrameNavigation.astro's own play/pause toggle, so this
      // reads as the same control language rather than a slightly different
      // icon for the same idea.
      const playPath = 'M6 4.5v11l9-5.5-9-5.5Z';
      const pausePath = 'M5.5 4.5h3v11h-3v-11ZM11.5 4.5h3v11h-3v-11Z';

      const formatElapsed = (ms: number) => {
        const totalSeconds = Math.floor(ms / 1000);
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        return `${minutes}:${String(seconds).padStart(2, '0')}`;
      };

      const setPlayIcon = (playing: boolean) => {
        panelPlayIcon.innerHTML = `<path d="${playing ? pausePath : playPath}" fill="currentColor" />`;
        const label = playing
          ? panelPlayToggle.dataset.labelPause!
          : panelPlayToggle.dataset.labelPlay!;
        panelPlayToggle.setAttribute('aria-label', label);
      };

      const togglePlay = () => {
        if (panelVideo.paused) panelVideo.play().catch(() => {});
        else panelVideo.pause();
      };

      // Clicking anywhere on the clip toggles playback, not just the centre
      // button — the button stays as an independently focusable control for
      // keyboard/screen-reader use, but pointer users shouldn't have to land
      // a click on a 56px target specifically. Guarded so a click that
      // already landed on the button doesn't also bubble up and fire this
      // handler a second time, which would toggle straight back to where it
      // started.
      panelMedia.addEventListener('click', (event) => {
        if (panelVideo.hidden) return;
        if (panelPlayToggle.contains(event.target as Node)) return;
        togglePlay();
      });
      panelPlayToggle.addEventListener('click', togglePlay);

      // Total clip length while idle (what's worth knowing before you press
      // play), live elapsed time while actually playing (what's worth
      // knowing once you have) — the same badge doing both jobs rather than
      // two separate pieces of UI.
      let clipDurationLabel = '0:00';

      panelVideo.addEventListener('play', () => {
        setPlayIcon(true);
        // Falls back to the CSS hover/focus-only reveal (see the button's
        // own classes) once actually playing — the button shouldn't sit
        // over the footage the whole time, only on hover, like YouTube's.
        panelPlayToggle.style.opacity = '';
      });
      panelVideo.addEventListener('timeupdate', () => {
        if (panelVideo.paused) return;
        panelDuration.textContent = formatElapsed(panelVideo.currentTime * 1000);
      });
      panelVideo.addEventListener('pause', () => {
        setPlayIcon(false);
        // Always visible while paused, overriding the CSS hover-only
        // default — otherwise there's nothing on screen hinting the clip is
        // playable at all until the visitor happens to hover it.
        panelPlayToggle.style.opacity = '1';
        // Back to the clip's total length — reached either by the visitor
        // pressing pause mid-way, or by playback running out on its own
        // (a 'pause'-then-implicit-stop at the end, not a separate 'ended'
        // case to handle).
        panelDuration.textContent = clipDurationLabel;
      });

      // The one thing actually available to download right now. Replaced,
      // never appended — the panel holds the latest result only, a single
      // slot rather than a gallery. The previous entry's object URL is
      // revoked on replacement so this can't leak memory across an
      // arbitrary number of captures in one visit.
      let current: { url: string; filename: string } | null = null;

      const setCurrent = (blob: Blob, filename: string) => {
        if (current) URL.revokeObjectURL(current.url);
        current = { url: URL.createObjectURL(blob), filename };
      };

      panelDownload.addEventListener('click', () => {
        if (!current) return;
        const link = document.createElement('a');
        link.href = current.url;
        link.download = current.filename;
        link.click();
      });

      // --- The fly-to-panel animation ---------------------------------------
      //
      // A FLIP-style move: clone the real captured image, plant it over the
      // video at its actual size, then animate it to the panel thumbnail's
      // own rect. Animates top/left/width/height directly, NOT a transform
      // scale: the video and the panel have different aspect ratios (the
      // panel column is narrower), so a non-uniform `scale(sx, sy)` visibly
      // stretched the image sideways right as it landed — transform distorts
      // the rendered pixels as a unit, it doesn't re-crop them the way
      // `object-fit: cover` does. Animating the actual box dimensions lets
      // `object-fit: cover` recompute the correct crop at every step, so the
      // image's own proportions never change, only how much of it shows.
      // Real layout cost for a single one-shot element over ~500ms is not
      // worth trading correctness for.
      const flyToPanel = (imageUrl: string, onArrive: () => void) => {
        const startRect = videoFigure.getBoundingClientRect();
        const endRect = panelThumb.getBoundingClientRect();

        const clone = document.createElement('img');
        clone.src = imageUrl;
        clone.alt = '';
        clone.style.position = 'fixed';
        clone.style.top = `${startRect.top}px`;
        clone.style.left = `${startRect.left}px`;
        clone.style.width = `${startRect.width}px`;
        clone.style.height = `${startRect.height}px`;
        clone.style.objectFit = 'cover';
        clone.style.borderRadius = getComputedStyle(videoFigure).borderRadius;
        clone.style.boxShadow = '0 30px 60px -20px rgb(0 0 0 / 0.5)';
        clone.style.zIndex = '80';
        clone.style.pointerEvents = 'none';
        document.body.appendChild(clone);

        // Two keyframes, no fade: the clone and the real thumbnail beneath
        // it are pixel-identical in position and size at the instant this
        // finishes, so cutting straight to the real image reads as the
        // capture simply "arriving" rather than a crossfade trying to hide
        // a mismatch.
        const anim = clone.animate(
          [
            {
              top: `${startRect.top}px`,
              left: `${startRect.left}px`,
              width: `${startRect.width}px`,
              height: `${startRect.height}px`,
            },
            {
              top: `${endRect.top}px`,
              left: `${endRect.left}px`,
              width: `${endRect.width}px`,
              height: `${endRect.height}px`,
            },
          ],
          {
            duration: 480,
            // Literal cubic-bezier, not var(--ease-out-expo): the Web
            // Animations API's `easing` option is not guaranteed to resolve
            // CSS custom properties the way an element's own `style` would.
            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            fill: 'forwards',
          },
        );

        // Both a real `finish` listener AND a timer fallback, not just the
        // former: confirmed directly in this project's dev environment (the
        // same one where requestAnimationFrame never fires for the volume
        // meter, see VolumeAmplification.astro) that a Web Animations API
        // animation can sit at playState "running" indefinitely and never
        // dispatch `finish` when the page isn't actually compositing frames.
        // `settled` guards against both firing — whichever gets there first
        // wins, so real browsers still settle right on the animation's own
        // finish and this harness settles a beat later instead of never.
        let settled = false;
        const settle = () => {
          if (settled) return;
          settled = true;
          onArrive();
          clone.remove();
        };
        anim.addEventListener('finish', settle);
        window.setTimeout(settle, 520);
      };

      // `mediaUrl` is the source for whichever element actually gets shown —
      // NOT necessarily `current.url`. For a frame, the downloadable PNG and
      // the displayed thumbnail are the same file, so they happen to match.
      // For a clip, `current.url` is the .webm — playable, but not
      // decodable as an <img> src — while `mediaUrl` here is either that
      // same .webm (for the real <video>) or the poster frame (unused by
      // <video>'s own `poster` attribute, set separately below). Passing it
      // explicitly rather than always reading `current.url` inside this
      // function is what the previous version got wrong: it set the panel
      // <img> to the clip's .webm blob, which no browser can render as an
      // image, leaving the thumbnail blank.
      const showResult = (
        kind: 'frame' | 'clip',
        posterUrl: string,
        durationLabel?: string,
      ) => {
        panelEmpty.style.opacity = '0';
        panelKind.textContent = kind === 'frame' ? frameLabel : clipLabel;
        panelFooter.hidden = false;

        if (kind === 'frame') {
          panelVideo.pause();
          panelVideo.hidden = true;
          panelVideo.style.opacity = '0';
          panelVideo.removeAttribute('src');
          panelPlayToggle.hidden = true;
          panelThumb.src = posterUrl;
          panelThumb.style.opacity = '1';
          panelThumb.hidden = false;
        } else {
          panelThumb.hidden = true;
          panelThumb.style.opacity = '0';
          panelThumb.src = '';
          panelVideo.poster = posterUrl;
          panelVideo.src = current!.url;
          panelVideo.hidden = false;
          panelVideo.style.opacity = '1';
          // New clip always lands paused (autoplay would be surprising for
          // something the visitor just finished recording) — reset the
          // toggle to its paused state explicitly rather than trusting a
          // leftover state from whatever the previous clip was doing.
          setPlayIcon(false);
          panelPlayToggle.style.opacity = '1';
          panelPlayToggle.hidden = false;
          clipDurationLabel = durationLabel ?? '0:00';
        }

        if (kind === 'clip' && durationLabel) {
          panelDuration.textContent = durationLabel;
          panelDuration.hidden = false;
        } else {
          panelDuration.hidden = true;
        }
      };

      // --- Screenshot --------------------------------------------------------
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');

      captureButton.addEventListener('click', () => {
        if (!ctx || !video.videoWidth) return;

        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

        flash.style.transition = 'none';
        flash.style.opacity = '0.7';
        void flash.offsetWidth;
        flash.style.transition = 'opacity 350ms ease-out';
        flash.style.opacity = '0';

        canvas.toBlob((blob) => {
          if (!blob) return;
          setCurrent(blob, `framewise-frame-${Date.now()}.png`);
          const frameUrl = current!.url;
          flyToPanel(frameUrl, () => showResult('frame', frameUrl));
        }, 'image/png');
      });

      // --- Clip recording ------------------------------------------------------
      let recorder: MediaRecorder | null = null;
      let chunks: Blob[] = [];
      let timerInterval: number | undefined;
      let startedAt = 0;
      let lastElapsedLabel = '0:00';

      const supportedType = [
        'video/webm;codecs=vp9',
        'video/webm;codecs=vp8',
        'video/webm',
      ].find((type) => MediaRecorder.isTypeSupported(type));

      const setRecordingUi = (recording: boolean) => {
        recordButton.setAttribute('aria-pressed', String(recording));
        recordLabel.textContent = recording
          ? recordButton.dataset.labelStop!
          : recordButton.dataset.labelStart!;
        // Filled circle while idle ("start recording"); square while active
        // ("stop") — the universal record/stop icon pair.
        recordIcon.innerHTML = recording
          ? '<rect x="4" y="4" width="12" height="12" rx="1.5" fill="var(--color-accent)"></rect>'
          : '<circle cx="10" cy="10" r="7" fill="var(--color-accent)"></circle>';
        recordIndicator.hidden = !recording;
      };

      const startRecording = () => {
        if (!supportedType || !video.videoWidth) return;
        const stream = (
          video as HTMLVideoElement & { captureStream: () => MediaStream }
        ).captureStream();
        chunks = [];
        recorder = new MediaRecorder(stream, { mimeType: supportedType });
        recorder.addEventListener('dataavailable', (event) => {
          if (event.data.size > 0) chunks.push(event.data);
        });
        recorder.addEventListener('stop', () => {
          const blob = new Blob(chunks, { type: supportedType });
          setCurrent(blob, `framewise-clip-${Date.now()}.webm`);

          // A real freeze frame of the video at the exact moment recording
          // stopped — the actual last frame of the clip just recorded, not
          // a generic icon standing in for "a video". Same canvas as the
          // screenshot path, reused rather than duplicated.
          let posterUrl = current!.url;
          if (ctx && video.videoWidth) {
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            posterUrl = canvas.toDataURL('image/png');
          }

          const durationLabel = lastElapsedLabel;
          flyToPanel(posterUrl, () =>
            showResult('clip', posterUrl, durationLabel),
          );
        });
        recorder.start();

        startedAt = performance.now();
        recordTimer.textContent = '0:00';
        lastElapsedLabel = '0:00';
        timerInterval = window.setInterval(() => {
          lastElapsedLabel = formatElapsed(performance.now() - startedAt);
          recordTimer.textContent = lastElapsedLabel;
        }, 250);

        setRecordingUi(true);
      };

      const stopRecording = () => {
        recorder?.stop();
        recorder = null;
        window.clearInterval(timerInterval);
        setRecordingUi(false);
      };

      if (!supportedType) {
        recordButton.hidden = true;
      } else {
        recordButton.addEventListener('click', () => {
          if (recorder) stopRecording();
          else startRecording();
        });
      }
    });
</script>
