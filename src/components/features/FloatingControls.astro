---
import FeatureHeading from './FeatureHeading.astro';
import DemoVideo from '../DemoVideo.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!--
  03 — copy (with its own button) sits centred like every other feature;
  only the video breaks away from that, bleeding halfway off the true left
  edge of the browser window. No enclosing panel/card either, unlike the
  original version of this section — every other feature is copy + media on
  the page background, and a bordered tinted box wrapping the whole thing
  read as an unexplained one-off.

  Two rounds of feedback shaped this:
  - First just moved the video to the section's own left edge — still felt
    like it belonged to the layout. Now it's cut off by the actual viewport
    edge, about half the card hidden past it, which needs `overflow-x: clip`
    on <body> (see global.css) so that hidden half doesn't turn into a
    horizontal scrollbar.
  - The float button first lived directly under the video, which meant it
    drifted off toward the edge along with it. Moved it back to sit with the
    copy instead — the awkwardly-placed video is the whole visual joke of
    this section, the control for fixing it shouldn't share in the
    awkwardness.

  Reaching the true viewport edge needs the video positioned `absolute`
  against an ancestor that spans the full window width — this outer
  <section> carries no max-width/centring of its own for exactly that
  reason. A negative margin (`calc(50% - 50vw)`) was tried first instead;
  that trick only works applied against a full-width ancestor, and nested
  inside this page's centred grid it resolved against the narrow grid track
  instead of the viewport, sending the video clean off-screen. The copy
  keeps its own centred `max-w-page` wrapper; only the video breaks out of
  it.

  Real native Picture-in-Picture — the button calls the browser's own
  requestPictureInPicture() on the actual <video>, not a custom draggable
  window standing in for it. document.pictureInPictureEnabled is checked at
  runtime and the button hides itself if the browser genuinely can't do it,
  rather than showing a control that would just fail silently on click.

  DemoVideo.astro's own play/pause-on-visibility logic is PiP-aware: popping
  the video out and then scrolling its on-page spot out of view does not pause
  it, which is the entire point of this feature ("keep working around it").

  `my-14`: this is the shortest of the five feature blocks by a wide margin
  (a small video, no stats/pills below it), which meant scrolling exactly one
  section's worth from here landed with the tail of 02 and the head of 04
  both still on screen at once. The shared `gap-feature` spacing between ALL
  five blocks can't be the fix — widening it would also push 01/02 and 04/05
  further apart, and those gaps already read correctly. Extra margin on this
  block alone adds the breathing room only where it's missing.
-->
<section aria-labelledby="f3-title" data-pip-demo class="relative my-14">
  <!--
    Reserves the left-hand space the video visually occupies at lg (its
    on-screen half, roughly) so the copy doesn't run underneath it, without
    the video itself being a layout participant there — it's absolutely
    positioned, entirely out of this flow.
  -->
  <div class="mx-auto max-w-page px-6 lg:pl-[22rem]">
    <FeatureHeading
      number="03"
      id="f3-title"
      label="f3.label"
      title="f3.title"
      body="f3.body"
      align="start"
      bodyClass="max-w-[24rem]"
    />

    <div class="mt-8 flex items-center gap-3">
      <button
        type="button"
        data-pip-toggle
        data-label-enter={t('f3.pip.enter')}
        data-label-exit={t('f3.pip.exit')}
        class="flex items-center gap-2 rounded-cta border border-line-strong px-6 py-3 text-ui font-medium transition-colors duration-150 hover:border-line-hover"
      >
        <svg
          data-pip-icon
          width="17"
          height="17"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <rect
            x="2"
            y="3.5"
            width="16"
            height="13"
            rx="1.8"
            stroke="currentColor"
            stroke-width="1.3"
          ></rect>
          <rect
            x="10.5"
            y="9.5"
            width="6"
            height="4.5"
            rx="0.8"
            fill="currentColor"
          ></rect>
        </svg>
        <span data-pip-label>{t('f3.pip.enter')}</span>
      </button>

      <p data-pip-unsupported hidden class="text-sm text-ink-faint">
        {t('f3.pip.unsupported')}
      </p>
    </div>
  </div>

  <!--
    Normal flow, left-aligned, on mobile (there's no room to bleed
    anything off-screen on a phone, and nothing is gained by trying).
    Absolutely positioned and shifted half off the viewport's true left
    edge from lg up.
  -->
  <figure
    class="relative mt-10 -ml-6 w-[min(23rem,70%)] overflow-hidden rounded-pip border border-line-compare shadow-frame-sm lg:absolute lg:top-1/2 lg:mt-0 lg:ml-0 lg:w-[20rem] lg:-translate-y-1/2 lg:left-[-10rem]"
  >
    <DemoVideo
      src="/media/aquarium.mp4"
      type="video/mp4"
      label={t('f3.video.label')}
      heightClass="h-[13.75rem] min-h-44"
    />
  </figure>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-pip-demo]').forEach((root) => {
    const video = root.querySelector<HTMLVideoElement>('[data-demo-video]');
    const button = root.querySelector<HTMLButtonElement>('[data-pip-toggle]');
    const label = root.querySelector<HTMLElement>('[data-pip-label]');
    const icon = root.querySelector<SVGElement>('[data-pip-icon]');
    const unsupportedNote = root.querySelector<HTMLElement>(
      '[data-pip-unsupported]',
    );
    if (!video || !button || !label || !icon || !unsupportedNote) return;

    // Feature-detect rather than assume: both target browsers support PiP,
    // but a site's own video element can also opt out individually via
    // disablePictureInPicture, and some embedded/restricted contexts (e.g.
    // certain iframes) disable it even where the browser normally allows it.
    const supported =
      'pictureInPictureEnabled' in document &&
      document.pictureInPictureEnabled &&
      !video.disablePictureInPicture;

    if (!supported) {
      button.hidden = true;
      unsupportedNote.hidden = false;
      return;
    }

    // Enter icon: outer frame + a filled inner rectangle (the "pop this bit
    // out" glyph). Exit icon: just the outer frame — the inner rectangle is
    // where the video *currently is*, so filling it no longer makes sense
    // once it's already floating.
    const frameRect =
      '<rect x="2" y="3.5" width="16" height="13" rx="1.8" stroke="currentColor" stroke-width="1.3"></rect>';
    const innerFill =
      '<rect x="10.5" y="9.5" width="6" height="4.5" rx="0.8" fill="currentColor"></rect>';

    const setUi = (inPip: boolean) => {
      label.textContent = inPip
        ? button.dataset.labelExit!
        : button.dataset.labelEnter!;
      icon.innerHTML = inPip ? frameRect : frameRect + innerFill;
    };

    button.addEventListener('click', async () => {
      try {
        if (document.pictureInPictureElement === video) {
          await document.exitPictureInPicture();
        } else {
          // requestPictureInPicture requires the video to have begun
          // playback (readyState HAVE_CURRENT_DATA or better) in most
          // browsers; DemoVideo's own autoplay means this is normally already
          // true by the time a visitor can click the button at all.
          await video.requestPictureInPicture();
        }
      } catch {
        // Rejected requests (e.g. the visitor already has another video in
        // PiP, or the gesture requirement wasn't met for some reason) just
        // leave the button in its current state — nothing to recover from.
      }
    });

    video.addEventListener('enterpictureinpicture', () => setUi(true));
    video.addEventListener('leavepictureinpicture', () => setUi(false));
  });
</script>
