---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { langLabels, languages, type Lang } from '../i18n/ui';
import { getLangFromUrl, getRouteFromUrl, useTranslations } from '../i18n/utils';

/**
 * Two-segment EN/ES switch.
 *
 * Real anchors to the localised URL of the *current* route — no JavaScript, and
 * it keeps working with the page open in a new tab. Styled after the volume
 * scale further down the page (pill track, filled active segment).
 */
const currentLang = getLangFromUrl(Astro.url);
const route = getRouteFromUrl(Astro.url);
const t = useTranslations(currentLang);

const options = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  /** Visible abbreviation — hidden from assistive tech in favour of the full name. */
  label: langLabels[code],
  /** Endonym, so a screen reader announces "Español" rather than "Spanish". */
  name: languages[code],
  href: getRelativeLocaleUrl(code, route),
  isActive: code === currentLang,
}));
---

<nav aria-label={t('nav.language')}>
  <ul
    class="flex items-center gap-1 rounded-pill border border-line bg-fill-subtle p-1 font-mono text-label"
  >
    {
      options.map(({ code, label, name, href, isActive }) => (
        <li>
          <!--
            The visible label is a two-letter abbreviation, so the accessible
            name comes from aria-label instead — spelled in the target language
            and paired with lang/hreflang so it is announced with the right
            pronunciation.
          -->
          <a
            href={href}
            hreflang={code}
            lang={code}
            aria-label={name}
            aria-current={isActive ? 'true' : undefined}
            data-lang-option={code}
            class:list={[
              'block rounded-pill px-2.5 py-1 tracking-chip transition-colors duration-200',
              isActive
                ? 'bg-ink font-medium text-bg'
                : 'text-ink-faint hover:text-ink',
            ]}
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Qué sección de <main> está a la vista ahora mismo, para que cambiar de idioma
  // aterrice en el mismo sitio en vez de en el top de la página. Reutiliza los mismos
  // bloques con id que ScrollProgress.astro ya usa como fuente de verdad de las
  // secciones — ambos hijos directos de <main>, así que no hace falta duplicar la lista.
  function currentSectionId(): string | undefined {
    const main = document.querySelector('main');
    if (!main) return undefined;

    // El header fijo tapa los primeros ~76px del viewport (ver scroll-margin-top de
    // cada sección); una sección solo cuenta como "vista" una vez su borde superior ha
    // pasado ese punto, igual que decide dónde aterriza su propio ancla.
    const headerOffset = 100;
    let current: string | undefined;
    for (const el of Array.from(main.children) as HTMLElement[]) {
      if (!el.id) continue;
      if (el.getBoundingClientRect().top <= headerOffset) current = el.id;
    }
    return current;
  }

  // Elección explícita: se guarda y a partir de ahí gana siempre sobre la detección del idioma del
  // navegador que hace Layout.astro en la raíz sin prefijo — mismo criterio que la extensión, donde
  // tocar el interruptor ES/EN fija el idioma para siempre hasta que se vuelva a tocar.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-option]').forEach((el) => {
    el.addEventListener('click', () => {
      try {
        localStorage.setItem('framewise-lang', el.dataset.langOption!);
      } catch (e) {
        // localStorage inaccesible (modo privado estricto, etc.) — la navegación sigue
        // funcionando con normalidad, simplemente no se recuerda la elección la próxima vez.
      }

      // Reescribe el href en el propio handler de click, antes de que el navegador lo
      // siga: en páginas sin estas secciones (privacy) currentSectionId() da undefined
      // y el href se deja tal cual.
      const id = currentSectionId();
      if (id) {
        const url = new URL(el.href);
        url.hash = id;
        el.href = url.toString();
      }
    });
  });
</script>
