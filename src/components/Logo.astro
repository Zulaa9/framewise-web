---
/**
 * Framewise mark: rounded square outline with an accent square inset toward the
 * top-left. Geometry matches the design export (21px box, 1.5px stroke).
 *
 * The outline uses `currentColor` so the footer can render it dimmed by setting
 * a text colour, exactly as the design does.
 */
interface Props {
  /** Rendered size in px. */
  size?: number;
  /** Fill of the inner square. Defaults to the brand accent. */
  accent?: string;
  class?: string;
}

const { size = 21, accent = 'var(--color-accent)', class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 21 21"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <rect
    x="0.75"
    y="0.75"
    width="19.5"
    height="19.5"
    rx="5.25"
    stroke="currentColor"
    stroke-width="1.5"
  />
  <rect x="3.5" y="3.5" width="8" height="8" rx="2" fill={accent} />
</svg>
